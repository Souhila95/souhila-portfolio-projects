!New XYCurve.FatorPvsT npts=4 xarray=[0 25 75 100] yarray=[1.2 1.0 .8 .6]
!New XYCurve.Eff npts=4 xarray=[.1 .2 .4 1.0] yarray=[.86 .9 .93 .97]
!New loadshape.IRR npts=24 interval=1 mult=(file=C:\Users\mumtahiu\Downloads\Battery\load\PVLoad.txt)
!New Tshape.tempCurve npts=24 interval=1 temp=(file=C:\Users\mumtahiu\Downloads\Battery\load\PVtemp.txt)

!Redirect PVsystem.txt



Set VoltageBases = "11,0.406,0.23"
CalcVoltageBases

! This command solves the base case power flow

set mode = daily
set stepsize = 1h
set number = 24


Set maxcontroli=100

Solve




!show current

!show voltage




